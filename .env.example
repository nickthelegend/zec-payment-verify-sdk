# Names only; put real values in a gitignored .env. Never commit keys.
# core / CLI
ZPV_UIVK=
ZPV_UFVK=
ZPV_LWD_URL=
# SOCKS5 proxy for lightwalletd, e.g. Tor: socks5h://127.0.0.1:9050 (never falls back to direct)
ZPV_LWD_PROXY=
# 1 allows plaintext http:// to a lightwalletd that is not on this machine
ZPV_ALLOW_INSECURE_LWD=
# sdk: path to the zpay-verify binary, Fuji RPC override
ZPV_BIN=
ZPV_FUJI_RPC=
# sdk: cross-check several lightwalletd endpoints (comma-separated) and how many must answer
ZPV_LWD_URLS=
ZPV_LWD_QUORUM=
# sdk: zpay-verify processes at once (default 8), checks waiting (default 32), kill after (ms, default 90000)
ZPV_MAX_CHECKS=
ZPV_MAX_QUEUE=
ZPV_CHECK_TIMEOUT_MS=
# gateway (paywall)
ZPV_PAY_TO=
ZPV_MERCHANT_UIVK=
ZPV_PRICE_ZAT=
ZPV_MIN_CONF=
# 1 allows ZPV_MIN_CONF=0 (mempool transactions can still be replaced)
ZPV_ALLOW_ZERO_CONF=
ZPV_PORT=
ZPV_CORS=
# SQLite file for the challenge key, paid memos/txids and refunds (shared by restarts, processes and the MCP tool)
ZPV_STORE=
# Bearer token for GET /api/refunds (at least 16 characters); without it the endpoint is off
ZPV_ADMIN_TOKEN=
# mcp
ZPV_MCP_LOG=
ZPV_MCP_MIN_CONF=
ZPV_MCP_REQUIRE_MEMO=
# dashboard
VITE_ZPV_API=
# examples (live run)
ZPV_FUNDER_WALLET=
ZPV_ZINGO_CLI=
